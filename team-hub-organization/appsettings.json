{
  "Jwt": {
    "Issuer": "AuthService",
    "Audience": "AuthServiceUsers"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "srv-organization"
  },
  "Quotas": {
    "MaxOrgsPerUser": 5,
    "MaxMembersPerOrg": 100,
    "MaxTeamsPerOrg": 50,
    "MaxPendingInvitesPerOrg": 50
  },
  "OrganizationLifecycle": {
    "RetentionDays": 30,
    "ActivityTtlDays": 90,
    "ImportArtifactTtlDays": 14,
    "IdempotencyTtlHours": 24,
    "PurgeIntervalMinutes": 60
  },
  "Seed": {
    "Enabled": false,
    "OwnerUsername": "JanWilk123",
    "OrganizationCount": 0,
    "MembersPerOrganization": 0,
    "TeamsPerOrganization": 0,
    "AdminCountPerOrganization": 0,
    "PendingInvitationCount": 0,
    "SlugPrefix": "demo-org",
    "NipBase": "5000000000"
  },
  "Observability": {
    "ServiceName": "team-hub-organization",
    "OtlpEndpoint": "http://localhost:4317"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.OpenTelemetry", "Serilog.Enrichers.Span" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithSpan" ],
    "Properties": {
      "Application": "team-hub-organization"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Level:u3}] [{TraceId}] [{SpanId}] [{CorrelationId}] [{SessionId}] [{UserId}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "endpoint": "http://localhost:4317",
          "protocol": "Grpc",
          "resourceAttributes": {
            "service.name": "team-hub-organization"
          }
        }
      }
    ]
  }
}
