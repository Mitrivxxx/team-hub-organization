@team_hub_organization_HostAddress = http://localhost:5002
@accessToken = {{login.response.body.accessToken}}

# Health
GET {{team_hub_organization_HostAddress}}/health
Accept: application/json

###

# Organizations
POST {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Acme Corp"
}

###

GET {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/{{organizationId}}
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/by-slug/acme-corp
Authorization: Bearer {{accessToken}}
Accept: application/json

###

PATCH {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/{{organizationId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Acme Corporation"
}

###

PUT {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/{{organizationId}}/avatar
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----AvatarBoundary

------AvatarBoundary
Content-Disposition: form-data; name="file"; filename="avatar.png"
Content-Type: image/png

< ./avatar.png
------AvatarBoundary--

###

DELETE {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/{{organizationId}}/avatar
Authorization: Bearer {{accessToken}}

###

DELETE {{team_hub_organization_HostAddress}}/api/organizations/v0.1.0/{{organizationId}}
Authorization: Bearer {{accessToken}}

###
